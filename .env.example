# second-brain-mcp environment
#
# You do NOT need a .env file to run the stack: docker-compose.yaml (local)
# and docker-compose-prod.yml (prod) set the runtime environment themselves,
# and `make deploy` sets IMAGE_TAG, HOST_UID and HOST_GID.
#
# These are the variables to set when running the server OUTSIDE Docker
# (e.g. `npm run dev` with Node 24), or to know what compose configures.
# Export them in your shell; nothing loads this file automatically.

# Directory of the vault git repo (required). Initialised on start if needed.
VAULT_PATH=./data/vault

# SQLite file for tokens and audit log. Required: the server and CLIs refuse
# to start without it. Its directory must exist.
DB_PATH=./data/acl.db

# HTTP port.
PORT=3000

# Git remote for the vault. Leave unset/empty for a local-only vault.
# VAULT_REMOTE_URL=git@github.com:your-org/your-vault.git

# Branch to track.
VAULT_BRANCH=main

# Periodic pull/push interval in ms (0 disables).
VAULT_SYNC_INTERVAL_MS=60000

# Max writes queued for the vault lock before new ones get "vault busy, retry later".
VAULT_WRITE_QUEUE_MAX=50

# Hostname/IP(s) allowed to set X-Forwarded-For. Empty = trust nobody.
# In Swarm behind Traefik: tasks.traefik_traefik
TRUSTED_PROXY=

# Git identity (git refuses to commit without one).
GIT_AUTHOR_NAME=second-brain-mcp
GIT_AUTHOR_EMAIL=second-brain-mcp@noreply.local
GIT_COMMITTER_NAME=second-brain-mcp
GIT_COMMITTER_EMAIL=second-brain-mcp@noreply.local

# Prod only (set by compose, shown for reference): SSH command using the deploy key secret.
# GIT_SSH_COMMAND=ssh -i /run/secrets/vault_deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=10
