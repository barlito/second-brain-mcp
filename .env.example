# second-brain-mcp environment
#
# You do NOT need a .env file to run the stack: docker-compose.yaml (local)
# and docker-compose-prod.yml (prod) set the runtime environment themselves,
# and `make deploy` sets IMAGE_TAG, HOST_UID and HOST_GID. Both compose files
# do require ADMIN_PROXY_SECRET and ADMIN_WEB_SECRET in the environment:
# `make deploy` generates them once into data/admin-*-secret (local); prod
# deploys read them from GitHub secrets (see docs/DEPLOY.md).
#
# These are the variables to set when running the server OUTSIDE Docker
# (e.g. `npm run dev` with Node 24), or to know what compose configures.
# Export them in your shell; nothing loads this file automatically.

# Directory of the vault git repo (required). Initialised on start if needed.
VAULT_PATH=./data/vault

# SQLite file for tokens and audit log. Required: the server and CLIs refuse
# to start without it. Its directory must exist.
DB_PATH=./data/acl.db

# HTTP port.
PORT=3000

# Git remote for the vault. Leave unset/empty for a local-only vault.
# VAULT_REMOTE_URL=git@github.com:your-org/your-vault.git

# Branch to track.
VAULT_BRANCH=main

# Periodic pull/push interval in ms (0 disables).
VAULT_SYNC_INTERVAL_MS=60000

# Max writes queued for the vault lock before new ones get "vault busy, retry later".
VAULT_WRITE_QUEUE_MAX=50

# Comma-separated hostnames, IPs or CIDRs allowed to set X-Forwarded-For
# (hostnames re-resolved every 60 s). Empty = trust nobody.
# Also required for the web admin UI. In Swarm behind Traefik: tasks.traefik_traefik
TRUSTED_PROXY=

# Local admin listener for the inbox CLI (bound to 127.0.0.1).
ADMIN_PORT=3001

# Web admin UI (behind Traefik + Authelia). It stays DISABLED unless
# TRUSTED_PROXY is set and ADMIN_PROXY_SECRET has at least 32 characters.
ADMIN_WEB_PORT=3002
# Authelia group (Remote-Groups) allowed in.
ADMIN_GROUP=admins
# Value Traefik injects as X-SB-Admin-Proxy after Authelia (openssl rand -hex 32).
# ADMIN_PROXY_SECRET=
# CSRF key; if unset a random one is generated per boot (open forms break on restart).
# ADMIN_WEB_SECRET=
# Authelia session cookie name the CSRF token is bound to.
AUTHELIA_SESSION_COOKIE=authelia_session

# kb_propose quotas: max pending proposals per token name / in total.
INBOX_MAX_PER_TOKEN=20
INBOX_MAX_TOTAL=200

# Per-space limits (per project, archive excluded) and auto-archive age; see README "Agents space and space limits".
# Format: space:key=value,key=value;space2:... Keys: maxNotes, maxNoteBytes, maxProjectBytes, archiveAfterDays.
# SPACE_LIMITS=agents:maxNotes=30,maxNoteBytes=4096,maxProjectBytes=102400,archiveAfterDays=60
# Auto-archive run interval in ms (also once after startup); 0 disables.
# AUTO_ARCHIVE_INTERVAL_MS=86400000

# Overall git push deadline incl. retries, in ms (test override).
# SB_PUSH_DEADLINE_MS=150000

# Git identity (git refuses to commit without one).
GIT_AUTHOR_NAME=second-brain-mcp
GIT_AUTHOR_EMAIL=second-brain-mcp@noreply.local
GIT_COMMITTER_NAME=second-brain-mcp
GIT_COMMITTER_EMAIL=second-brain-mcp@noreply.local

# Prod only (set by compose, shown for reference): SSH command using the deploy key secret.
# GIT_SSH_COMMAND=ssh -i /run/secrets/vault_deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=10
