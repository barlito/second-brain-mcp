# Variables requises par docker-compose.yml (déploiement PRODUCTION uniquement,
# via Traefik sur le VPS). Pour le dev local, docker-compose.override.yml
# retire cette dépendance (port publié directement, pas de réseau Traefik) :
# aucune de ces variables n'est nécessaire pour lancer `make up` en local.

# Nom de domaine public exposé par Traefik pour ce service
MCP_DOMAIN=second-brain.example.com

# Resolver Traefik utilisé pour la génération du certificat TLS
TRAEFIK_CERT_RESOLVER=letsencrypt

# Nom du réseau Docker externe partagé avec Traefik
TRAEFIK_NETWORK_NAME=traefik
